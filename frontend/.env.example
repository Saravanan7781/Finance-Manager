# Where the Express API lives. On a phone this must be your computer's LAN address or a deployed URL,
# not localhost (the Android emulator reaches the host at http://10.0.2.2:5000).
EXPO_PUBLIC_API_URL=http://localhost:5000

# Firebase web app config (Project settings > General > Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Set to 1 to run on built-in sample data with no backend or Firebase (handy for trying the design)
EXPO_PUBLIC_DEMO=
