# Port the API listens on
PORT=5000

# Comma-separated browser origins allowed by CORS (native apps send no Origin and are always allowed)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Set to "production" to hide internal error messages
NODE_ENV=development

# Firebase Admin credentials. Either drop serviceAccountKey.json next to config/firebase.js,
# or paste the whole service account JSON on one line here.
FIREBASE_SERVICE_ACCOUNT=
